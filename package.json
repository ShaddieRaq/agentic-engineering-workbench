{
  "name": "agentic-engineering-workbench",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "tsx src/index.ts",
    "agent": "tsx src/index.ts",
    "agents": "tsx src/runAgents.ts",
    "web": "npm run web:build && tsx src/runWeb.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:client": "vite --config web/vite.config.ts --host 127.0.0.1",
    "workspaces": "tsx src/runWorkspaces.ts",
    "dataset": "tsx src/runDataset.ts",
    "experiment": "tsx src/runExperiment.ts",
    "list-files": "tsx src/runListFilesTool.ts",
    "read-file": "tsx src/runReadFileTool.ts",
    "search-text": "tsx src/runSearchTextTool.ts",
    "inspect-package": "tsx src/runInspectPackageTool.ts",
    "inspect-git-diff": "tsx src/runInspectGitDiffTool.ts",
    "inspect-repository": "tsx src/runRepositoryInspection.ts",
    "analyze-repository": "tsx src/runRepositoryAnalysis.ts",
    "assist-repository": "tsx src/runRepositoryAssistant.ts",
    "replay": "tsx src/runReplay.ts",
    "report": "tsx src/runReport.ts",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.0",
    "openai": "^6.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
